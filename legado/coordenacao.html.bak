<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coordenadoria - Instituto Três Pontinhos</title>
  <link rel="stylesheet" href="css/estilo.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">

  <style>
    header { background-color: var(--azul-vibrante); padding: 0.8rem 6%; display: flex; justify-content: space-between; align-items: center; color: white; }
    .container { padding: 2rem 4%; max-width: 1400px; margin: 0 auto; }

    .menu-coordenacao { display: flex; gap: 1rem; margin-bottom: 2rem; border-bottom: 2px solid var(--cor-borda); padding-bottom: 0.5rem; }
    .btn-nav-coord { background: none; border: none; font-size: 1rem; font-weight: 700; color: var(--texto-suave); padding: 0.6rem 1.2rem; cursor: pointer; border-radius: 8px; }
    .btn-nav-coord.active { background-color: var(--azul-vibrante); color: white; }

    .secao-aba { display: none; }
    .secao-aba.active { display: block; }

    /* CALENDÁRIO MENSAL COMPLETO */
    .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .google-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; background: #ffffff; padding: 1rem; border-radius: var(--raio-borda); border: 1px solid var(--cor-borda); }
    .cal-day-head { font-weight: 800; text-align: center; color: var(--azul-escuro); padding: 0.5rem; background: #f1f5f9; border-radius: 6px; }
    .cal-cell { min-height: 110px; border: 1px solid var(--cor-borda); border-radius: 8px; padding: 0.4rem; background: #fafafa; cursor: pointer; transition: background 0.2s; }
    .cal-cell:hover { background: #f0f9ff; }
    .cal-date-number { font-size: 0.85rem; font-weight: 800; color: var(--azul-escuro); margin-bottom: 0.3rem; }
    
    .event-card { background: #e0f2fe; border-left: 4px solid var(--azul-vibrante); border-radius: 4px; padding: 0.2rem 0.4rem; font-size: 0.72rem; margin-bottom: 0.2rem; }

    /* MODAL DE CONSULTA DO DIA & REMARCAÇÃO */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
    .modal-box { background: white; padding: 2rem; border-radius: var(--raio-borda); width: 90%; max-width: 600px; max-height: 85vh; overflow-y: auto; }

    /* PACIENTES CADASTRADOS & FILTROS */
    .toolbar-pacientes { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .grid-pacientes { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }
    .card-paciente { background: white; border: 1px solid var(--cor-borda); border-radius: var(--raio-borda); padding: 1.5rem; box-shadow: var(--sombra-card); }
    .foto-paciente { width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 3px solid var(--azul-vibrante); }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-weight: 700; font-size: 0.8rem; margin-bottom: 0.3rem; color: var(--azul-escuro); }
    .input-edit { width: 100%; padding: 0.5rem; border: 1px solid var(--cor-borda); border-radius: 6px; font-size: 0.85rem; }
  </style>
</head>
<body>

  <header>
    <!-- LOGOTIPO ATUALIZADO SEM FUNDO PRETO E COM A FONTE CURVADA COMFORTAA -->
    <a href="index.html" class="brand-logo-container">
      <svg class="logo-face-svg" viewBox="0 0 100 80">
        <circle class="face-blue" cx="25" cy="25" r="10" />
        <circle class="face-blue eye-right" cx="75" cy="25" r="10" />
        <path class="face-blue" d="M 15 45 Q 50 85 85 45 Q 50 65 15 45 Z" />
        <path class="tongue-orange" d="M 50 60 Q 60 70 70 58 Z" />
      </svg>
      <div class="logo-text-group">
        <span class="sub">Instituto</span>
        <span class="title">três pontinhos</span>
        <span class="slogan">Acolher, ajudar e acompanhar</span>
      </div>
    </a>

    <div>
      <span style="font-weight: 700; margin-right: 1rem;">Mariana Silva (Coordenadoria)</span>
      <a href="login.html" onclick="localStorage.clear()" style="color: white; font-weight: 700; text-decoration: none; background: rgba(255,255,255,0.2); padding: 0.4rem 0.8rem; border-radius: 6px;">Sair</a>
    </div>
  </header>

  <div class="container">

    <div class="menu-coordenacao">
      <button class="btn-nav-coord active" onclick="trocarAbaCoord('agendamentos', this)">📅 Agendamentos (Calendário Mensal)</button>
      <button class="btn-nav-coord" onclick="trocarAbaCoord('pacientes', this)">👥 Pacientes Cadastrados</button>
      <button class="btn-nav-coord" onclick="trocarAbaCoord('cadastro', this)">➕ Cadastro de Novo Paciente</button>
    </div>

    <!-- NOTIFICAÇÃO DE SOLICITAÇÃO DO PROFISSIONAL -->
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h4 style="color: var(--azul-vibrante);">📩 Solicitação de Próxima Consulta Enviada pelo Profissional</h4>
        <p style="font-size: 0.85rem; color: var(--texto-suave);">O Profissional solicitou a remarcação/marcação para o paciente <strong>Lucas Oliveira</strong>.</p>
      </div>
      <button class="btn-nav-coord active" style="font-size: 0.85rem; padding: 0.5rem 1rem;" onclick="abrirModalRemarcacao('Lucas Oliveira')">Escolher Dia & Horário Disponível</button>
    </div>

    <!-- ABA 1: CALENDÁRIO MENSAL COMPLETO -->
    <div id="abaAgendamentos" class="secao-aba active">
      <div class="calendar-header">
        <h3 style="color: var(--azul-escuro);">Calendário de Atendimentos - Outubro 2026</h3>
        <div>
          <button style="padding: 0.4rem 0.8rem; border: 1px solid var(--cor-borda); background: white; border-radius: 6px; cursor: pointer;">&lt; Mês Anterior</button>
          <button style="padding: 0.4rem 0.8rem; border: 1px solid var(--cor-borda); background: white; border-radius: 6px; cursor: pointer;">Próximo Mês &gt;</button>
        </div>
      </div>

      <div class="google-calendar-grid">
        <div class="cal-day-head">DOM</div><div class="cal-day-head">SEG</div><div class="cal-day-head">TER</div><div class="cal-day-head">QUA</div><div class="cal-day-head">QUI</div><div class="cal-day-head">SEX</div><div class="cal-day-head">SÁB</div>

        <!-- Grade Mensal Completa (Exemplo de Dias) -->
        <div class="cal-cell" onclick="verDetalhesDia(28)"><div class="cal-date-number">28</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(29)"><div class="cal-date-number">29</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(30)">
          <div class="cal-date-number">30</div>
          <div class="event-card"><strong>Lucas Oliveira</strong><br>14:00 | Terapia ABA</div>
        </div>
        <div class="cal-cell" onclick="verDetalhesDia(1)">
          <div class="cal-date-number">1</div>
          <div class="event-card" style="background:#fef3c7; border-color:#f59e0b;"><strong>Gabriel Santos</strong><br>15:30 | Psicoterapia</div>
        </div>
        <div class="cal-cell" onclick="verDetalhesDia(2)">
          <div class="cal-date-number">2</div>
          <div class="event-card" style="background:#dcfce7; border-color:#22c55e;"><strong>Beatriz Lima</strong><br>10:00 | Terapia Nutricional</div>
        </div>
        <div class="cal-cell" onclick="verDetalhesDia(3)"><div class="cal-date-number">3</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(4)"><div class="cal-date-number">4</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(5)"><div class="cal-date-number">5</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(6)"><div class="cal-date-number">6</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(7)"><div class="cal-date-number">7</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(8)"><div class="cal-date-number">8</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(9)"><div class="cal-date-number">9</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(10)"><div class="cal-date-number">10</div></div>
        <div class="cal-cell" onclick="verDetalhesDia(11)"><div class="cal-date-number">11</div></div>
      </div>
    </div>

    <!-- ABA 2: PACIENTES CADASTRADOS E OPÇÕES DE ORDENAÇÃO -->
    <div id="abaPacientes" class="secao-aba">
      <div class="toolbar-pacientes">
        <h3 style="color: var(--azul-escuro);">Pacientes Acompanhados</h3>
        
        <div>
          <label style="font-weight: 700; font-size: 0.85rem; margin-right: 0.5rem;">Organizar por:</label>
          <select id="selectOrdenacao" onchange="ordenarPacientes()" style="padding: 0.5rem; border-radius: 6px; border: 1px solid var(--cor-borda);">
            <option value="alfabetica">Ordem Alfabética (A-Z)</option>
            <option value="registro">Data de Registro (Mais Recentes)</option>
            <option value="idade">Idade</option>
          </select>
        </div>
      </div>

      <div class="grid-pacientes" id="containerPacientes">
        <!-- CARD PACIENTE 1 -->
        <div class="card-paciente" data-nome="Lucas Oliveira" data-idade="7" data-registro="2026-01-10">
          <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
            <img src="https://images.unsplash.com/photo-1543332164-6e82f355badc?w=150" class="foto-paciente" alt="Foto Paciente">
            <div>
              <input type="text" class="input-edit" value="Lucas Oliveira" style="font-weight: 800; font-size: 1rem;">
              <span style="background-color: #fef3c7; color: #92400e; font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 20px; display: inline-block; margin-top: 0.3rem;">🎂 Aniversário em 12 dias!</span>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group"><label>Idade:</label><input type="text" class="input-edit" value="7 anos"></div>
            <div class="form-group"><label>Responsável:</label><input type="text" class="input-edit" value="Maria Oliveira"></div>
            <div class="form-group"><label>Telefone Resp.:</label><input type="text" class="input-edit" value="(85) 98888-7777"></div>
            <div class="form-group"><label>CPF Resp.:</label><input type="text" class="input-edit" value="123.456.789-00"></div>
          </div>

          <div class="form-group">
            <label>Tipo de Terapia:</label>
            <select class="input-edit">
              <option selected>Terapia ABA + Psicomotricidade</option>
              <option>Psicoterapia</option>
              <option>Terapia Nutricional</option>
            </select>
          </div>

          <div class="form-grid">
            <div class="form-group"><label>Status do Tratamento:</label><input type="text" class="input-edit" value="Em Evolução"></div>
            <div class="form-group"><label>Prazo de Pagamento:</label><input type="text" class="input-edit" value="Dia 10 (Em Dia)"></div>
          </div>

          <button style="width: 100%; background: var(--azul-vibrante); color: white; border: none; padding: 0.6rem; border-radius: 8px; font-weight: 700; cursor: pointer;" onclick="alert('✅ Informações atualizadas!')">💾 Salvar Alterações</button>
        </div>
      </div>
    </div>

    <!-- ABA 3: FORMULÁRIO DE NOVO PACIENTE COM TODOS OS CAMPOS SOLICITADOS -->
    <div id="abaCadastro" class="secao-aba">
      <div style="background: white; padding: 2rem; border-radius: var(--raio-borda); border: 1px solid var(--cor-borda); max-width: 800px; margin: 0 auto;">
        <h3 style="color: var(--azul-escuro); margin-bottom: 1.5rem;">Formulário de Cadastro de Paciente</h3>
        
        <form onsubmit="cadastrarPacienteCompleto(event)">
          <div class="form-grid">
            <div class="form-group">
              <label>Nome Completo do Paciente *</label>
              <input type="text" class="input-edit" required placeholder="Nome da criança">
            </div>
            <div class="form-group">
              <label>Foto do Paciente</label>
              <input type="file" class="input-edit" accept="image/*">
            </div>
            <div class="form-group">
              <label>Idade / Data de Nascimento *</label>
              <input type="date" class="input-edit" required>
            </div>
            <div class="form-group">
              <label>Nome do Responsável *</label>
              <input type="text" class="input-edit" required placeholder="Nome do pai/mãe/tutor">
            </div>
            <div class="form-group">
              <label>Telefone do Responsável *</label>
              <input type="text" class="input-edit" required placeholder="(00) 00000-0000">
            </div>
            <div class="form-group">
              <label>CPF do Responsável *</label>
              <input type="text" class="input-edit" required placeholder="000.000.000-00">
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Tipo de Terapia *</label>
              <select class="input-edit">
                <option>Terapia ABA + Psicomotricidade</option>
                <option>Psicoterapia</option>
                <option>Terapia Nutricional</option>
              </select>
            </div>
            <div class="form-group">
              <label>Dia de Pagamento *</label>
              <input type="text" class="input-edit" required placeholder="Ex: Todo dia 05">
            </div>
          </div>

          <button type="submit" style="background: var(--laranja-brand); color: white; border: none; padding: 0.8rem 1.8rem; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 1rem;">Concluir Cadastro do Paciente</button>
        </form>
      </div>
    </div>

  </div>

  <!-- MODAL DE ESCOLHA DE DIAS E HORÁRIOS DISPONÍVEIS PARA REMARCAÇÃO -->
  <div class="modal-overlay" id="modalRemarcacao">
    <div class="modal-box">
      <h3 style="color: var(--azul-escuro); margin-bottom: 0.5rem;">Escolher Dia e Horário Disponível</h3>
      <p style="font-size: 0.85rem; color: var(--texto-suave); margin-bottom: 1.5rem;">Solicitação do Profissional para o paciente <strong id="nomePacienteRemarcar">Lucas Oliveira</strong>.</p>

      <div class="form-group">
        <label>Selecione a Data Livre no Calendário:</label>
        <input type="date" class="input-edit" value="2026-10-05">
      </div>

      <div class="form-group">
        <label>Horários Livres Encontrados:</label>
        <select class="input-edit">
          <option>09:00 - Vago</option>
          <option selected>14:00 - Vago</option>
          <option>16:30 - Vago</option>
        </select>
      </div>

      <div class="form-group">
        <label>Tipo de Terapia:</label>
        <select class="input-edit">
          <option>Terapia ABA + Psicomotricidade</option>
          <option>Psicoterapia</option>
          <option>Terapia Nutricional</option>
        </select>
      </div>

      <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
        <button style="flex:1; background: var(--azul-vibrante); color: white; border: none; padding: 0.7rem; border-radius: 8px; font-weight: 700; cursor: pointer;" onclick="confirmarAgendamento()">Confirmar Agendamento</button>
        <button style="flex:1; background: #cbd5e1; border: none; padding: 0.7rem; border-radius: 8px; cursor: pointer;" onclick="fecharModalRemarcacao()">Cancelar</button>
      </div>
    </div>
  </div>

  <script>
    // PISCADA DE OLHO AO CLICAR EM BOTÕES
    document.addEventListener('click', function(e) {
      if (e.target.tagName === 'BUTTON' || e.target.closest('button') || e.target.closest('.brand-logo-container')) {
        const logo = document.querySelector('.brand-logo-container');
        if (logo) {
          logo.classList.add('piscando');
          setTimeout(() => logo.classList.remove('piscando'), 200);
        }
      }
    });

    function trocarAbaCoord(abaId, btn) {
      document.querySelectorAll('.btn-nav-coord').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.secao-aba').forEach(s => s.classList.remove('active'));

      btn.classList.add('active');
      if(abaId === 'agendamentos') document.getElementById('abaAgendamentos').classList.add('active');
      if(abaId === 'pacientes') document.getElementById('abaPacientes').classList.add('active');
      if(abaId === 'cadastro') document.getElementById('abaCadastro').classList.add('active');
    }

    function verDetalhesDia(dia) {
      alert(`📅 Consultando compromissos e horários para o Dia ${dia}...`);
    }

    function abrirModalRemarcacao(nome) {
      document.getElementById('nomePacienteRemarcar').innerText = nome;
      document.getElementById('modalRemarcacao').style.display = 'flex';
    }

    function fecharModalRemarcacao() {
      document.getElementById('modalRemarcacao').style.display = 'none';
    }

    function confirmarAgendamento() {
      alert("✅ Consulta agendada com sucesso no calendário!");
      fecharModalRemarcacao();
    }

    function cadastrarPacienteCompleto(e) {
      e.preventDefault();
      alert("✅ Novo paciente cadastrado com sucesso!");
      trocarAbaCoord('pacientes', document.querySelectorAll('.btn-nav-coord')[1]);
    }

    function ordenarPacientes() {
      const criterio = document.getElementById('selectOrdenacao').value;
      alert(`🔄 Pacientes reordenados por: ${criterio}`);
    }
  </script>

</body>
</html>