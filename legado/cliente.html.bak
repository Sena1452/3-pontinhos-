<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Área do Cliente - Instituto Três Pontinhos</title>
  <link rel="stylesheet" href="css/estilo.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">

  <style>
    header {
      background-color: var(--azul-vibrante);
      padding: 1rem 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }

    .brand-logo-btn {
      background-color: var(--laranja-brand);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      color: white;
      font-weight: 800;
      text-decoration: none;
      transition: var(--transicao);
    }

    .brand-logo-btn:hover {
      background-color: var(--laranja-hover);
    }

    .user-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .container {
      padding: 3rem 6%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .welcome-card {
      background: linear-gradient(135deg, var(--azul-vibrante) 0%, var(--azul-escuro) 100%);
      color: white;
      padding: 2rem;
      border-radius: var(--raio-borda);
      margin-bottom: 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--sombra-card);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .secao-titulo {
      color: var(--azul-escuro);
      font-size: 1.4rem;
      margin-bottom: 1.2rem;
      font-weight: 800;
    }

    .grid-consultas {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .card-consulta {
      background: white;
      border-radius: var(--raio-borda);
      padding: 1.5rem;
      border: 1px solid var(--cor-borda);
      box-shadow: var(--sombra-card);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .info-data {
      color: var(--azul-vibrante);
      font-weight: 800;
      font-size: 1.1rem;
      margin-bottom: 0.4rem;
    }

    /* MODAL DE AGENDAMENTO */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.5);
      justify-content: center;
      align-items: center;
      padding: 1rem;
      z-index: 1000;
    }

    .modal-content {
      background: white;
      border-radius: var(--raio-borda);
      padding: 2rem;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-weight: 700;
      margin-bottom: 0.3rem;
      font-size: 0.85rem;
    }

    .form-group select, .form-group input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--cor-borda);
      border-radius: 8px;
    }
  </style>
</head>
<body>

  <header>
    <!-- LOGO COMO BOTÃO PARA VOLTAR PARA A PÁGINA INICIAL -->
    <a href="index.html" class="brand-logo-btn" title="Voltar para a Página Inicial">::: três pontinhos</a>
    
    <div class="user-nav">
      <span id="nomeUsuario">Bem-vindo(a), Cliente</span>
      <a href="login.html" class="btn-laranja" onclick="localStorage.clear()" style="padding: 0.4rem 1rem;">Sair</a>
    </div>
  </header>

  <div class="container">
    
    <div class="welcome-card">
      <div>
        <h2>Sua Área de Atendimento</h2>
        <p>Agende e acompanhe suas consultas com facilidade.</p>
      </div>
      <button class="btn-laranja" onclick="abrirModalAgendamento()">+ Agendar Nova Consulta</button>
    </div>

    <h3 class="secao-titulo">Próximos Agendamentos</h3>
    <div class="grid-consultas" id="listaAgendamentos">
      <!-- Inserido dinamicamente via JS -->
    </div>

    <h3 class="secao-titulo">Histórico de Atendimentos</h3>
    <div class="grid-consultas">
      <div class="card-consulta">
        <div>
          <div class="info-data" style="color: var(--texto-suave);">🗓️ 01 de Setembro - 14:00</div>
          <div style="font-weight:700;">Dra. Ana Souza</div>
          <div style="color:var(--texto-suave); font-size:0.9rem;">Psicologia Infantil</div>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
          <span class="badge-status status-concluido">Concluído</span>
          <button class="btn-primary" onclick="alert('Baixando relatório da sessão...')" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: var(--texto-suave);">Baixar Ficha</button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL DE NOVO AGENDAMENTO -->
  <div class="modal" id="modalAgendamento">
    <div class="modal-content">
      <div class="modal-header">
        <h3 style="color: var(--azul-escuro);">Agendar Consulta</h3>
        <button onclick="fecharModalAgendamento()" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">&times;</button>
      </div>

      <form onsubmit="salvarNovoAgendamento(event)">
        <div class="form-group">
          <label>Especialidade</label>
          <select id="selectEspecialidade" required onchange="atualizarProfissionais()">
            <option value="">Selecione...</option>
            <option value="Psicologia Infantil">Psicologia Infantil</option>
            <option value="Fonoaudiologia">Fonoaudiologia</option>
            <option value="Terapia Ocupacional">Terapia Ocupacional</option>
          </select>
        </div>

        <div class="form-group">
          <label>Profissional</label>
          <select id="selectProfissional" required>
            <option value="">Selecione a especialidade primeiro</option>
          </select>
        </div>

        <div class="form-group">
          <label>Data e Horário</label>
          <input type="datetime-local" id="dataAgendamento" required>
        </div>

        <button type="submit" class="btn-laranja" style="width:100%; margin-top: 1rem;">Confirmar Agendamento</button>
      </form>
    </div>
  </div>

  <script>
    const usuario = JSON.parse(localStorage.getItem('usuarioLogado')) || { nome: 'Maria Silva' };
    document.getElementById('nomeUsuario').innerText = `Bem-vindo(a), ${usuario.nome}`;

    let agendamentos = JSON.parse(localStorage.getItem('db_agendamentos')) || [
      { id: 1, profissional: 'Dra. Ana Souza', especialidade: 'Psicologia Infantil', data: '2026-10-15T14:00', status: 'Confirmado' },
      { id: 2, profissional: 'Dr. Carlos Lima', especialidade: 'Fonoaudiologia', data: '2026-10-28T10:30', status: 'Confirmado' }
    ];

    function renderizarAgendamentos() {
      const container = document.getElementById('listaAgendamentos');
      container.innerHTML = '';

      if (agendamentos.length === 0) {
        container.innerHTML = '<p style="color: var(--texto-suave);">Nenhum agendamento ativo.</p>';
        return;
      }

      agendamentos.forEach(item => {
        const dataFormatada = new Date(item.data).toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short' });
        container.innerHTML += `
          <div class="card-consulta">
            <div>
              <div class="info-data">🗓️ ${dataFormatada}</div>
              <div style="font-weight:700;">${item.profissional}</div>
              <div style="color:var(--texto-suave); font-size:0.9rem;">${item.especialidade}</div>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
              <span class="badge-status status-confirmado">${item.status}</span>
              <button class="btn-primary" onclick="cancelarAgendamento(${item.id})" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background:#dc2626;">Cancelar</button>
            </div>
          </div>
        `;
      });
    }

    function abrirModalAgendamento() { document.getElementById('modalAgendamento').style.display = 'flex'; }
    function fecharModalAgendamento() { document.getElementById('modalAgendamento').style.display = 'none'; }

    function atualizarProfissionais() {
      const esp = document.getElementById('selectEspecialidade').value;
      const selectProf = document.getElementById('selectProfissional');
      selectProf.innerHTML = '';

      if (esp === 'Psicologia Infantil') {
        selectProf.innerHTML = '<option value="Dra. Ana Souza">Dra. Ana Souza</option>';
      } else if (esp === 'Fonoaudiologia') {
        selectProf.innerHTML = '<option value="Dr. Carlos Lima">Dr. Carlos Lima</option>';
      } else if (esp === 'Terapia Ocupacional') {
        selectProf.innerHTML = '<option value="Dra. Juliana Paes">Dra. Juliana Paes</option>';
      }
    }

    function salvarNovoAgendamento(e) {
      e.preventDefault();
      const novo = {
        id: Date.now(),
        especialidade: document.getElementById('selectEspecialidade').value,
        profissional: document.getElementById('selectProfissional').value,
        data: document.getElementById('dataAgendamento').value,
        status: 'Confirmado'
      };

      agendamentos.push(novo);
      localStorage.setItem('db_agendamentos', JSON.stringify(agendamentos));
      fecharModalAgendamento();
      renderizarAgendamentos();
      alert("✅ Consulta agendada com sucesso!");
    }

    function cancelarAgendamento(id) {
      if (confirm("Tem certeza que deseja cancelar esta consulta?")) {
        agendamentos = agendamentos.filter(a => a.id !== id);
        localStorage.setItem('db_agendamentos', JSON.stringify(agendamentos));
        renderizarAgendamentos();
      }
    }

    renderizarAgendamentos();
  </script>

</body>
</html>